# demo mode: ใช้ข้อมูลจำลอง ไม่ต้องตั้ง backend (true = เทสต์ UI ได้ทันที)
VITE_DEMO=true

# URL ของ Google Apps Script Web App ที่ deploy แล้ว (ใช้เมื่อ VITE_DEMO=false)
# ไปที่ Apps Script > Deploy > New deployment > Web app > คัดลอก URL เช่น https://script.google.com/macros/s/xxxxx/exec
VITE_GAS_URL=